# ---------------------------------------------------------------------------
# Lemma environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Supabase (required) ----------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (required for /api/explain) ---------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to a cost-effective model.
LEMMA_EXPLAIN_MODEL=claude-haiku-4-5

# --- Web app --------------------------------------------------------------
# Public origin of the web app. Used by the extension auth handoff.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Extension build -----------------------------------------------------
# Base URL the extension calls for the API. Mirrors NEXT_PUBLIC_APP_URL.
VITE_API_BASE=http://localhost:3000

# --- Follow-up features (not needed for the core loop) ------------------
# OPENAI_API_KEY=sk-...
# RESEND_API_KEY=re_...
