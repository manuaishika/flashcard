{
  "name": "lemma",
  "version": "0.1.0",
  "private": true,
  "description": "Lemma — a personal semantic memory system for words you encounter while reading.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "web": "pnpm --filter @lemma/web dev",
    "extension": "pnpm --filter @lemma/extension dev",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
